#!/bin/sh
# git-credential-github — Git credential helper for github.com.
#
# Why this exists:
#   Codespaces injects GITHUB_TOKEN, but that token is scoped to the
#   repository the codespace was created from. Pushing to any other repo
#   (even one your account can write to) fails with:
#     remote: Permission to <owner>/<repo>.git denied to <user>
#     fatal: ... The requested URL returned error: 403
#
#   This helper supplies a personal access token instead, so pushes work
#   normally. Token lookup order:
#     1. GH_PAT / GITHUB_PAT / GH_TOKEN (Codespaces secret or exported var)
#     2. ~/.config/git/github-pat (chmod 600, optional)
#     3. `gh auth token` (when the GitHub CLI is signed in)
#
#   Run `git-auth` to install it and check the token.
#
# Configured per-repository as:
#   credential.helper = /home/vscode/.local/bin/git-credential-github

# Only handle "get"; "store"/"erase" are no-ops (the token lives in a secret).
[ "$1" = "get" ] || exit 0

token="${GH_PAT:-${GITHUB_PAT:-${GH_TOKEN:-}}}"

if [ -z "${token}" ] && [ -r "${HOME}/.config/git/github-pat" ]; then
    token="$(tr -d '\r\n' < "${HOME}/.config/git/github-pat")"
fi

if [ -z "${token}" ] && command -v gh >/dev/null 2>&1; then
    token="$(gh auth token 2>/dev/null || true)"
fi

# No usable token: let Git fall through to any other configured helper.
[ -n "${token}" ] || exit 0

printf 'username=x-access-token\npassword=%s\n' "${token}"
