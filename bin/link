#!/usr/bin/env bash
# link — print the public ngrok URL of the app served on port 8000.
#        Starts the tunnel if none is running, or reuses the existing one.
#        Also updates APP_URL in the app .env so it matches the tunnel.
#        Works from anywhere (walks up the tree to find the app .env).
#
# Requires: an ngrok authtoken (NGROK_AUTHTOKEN env, ~/.ngrok-token,
#           or pre-configured via `ngrok config add-authtoken`).
set -u

PORT=8000
API_URL="http://127.0.0.1:4040/api/tunnels"

resolve_url() {
    # never let a curl/network failure kill this script (no set -e here,
    # and no pipefail on this pipeline): return empty on any error
    local resp
    resp="$(curl -s --max-time 2 "${API_URL}" 2>/dev/null)" || return 0
    [ -n "${resp}" ] || return 0
    printf '%s' "${resp}" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{console.log(JSON.parse(s).tunnels[0].public_url)}catch(e){}})'
    return 0
}

locate_app() {
    local DIR="$PWD"
    if [ -f "${DIR}/.env" ]; then
        printf '%s' "${DIR}/.env"
    elif [ -f "${DIR}/${APP_DIR:-src}/.env" ]; then
        printf '%s' "${DIR}/${APP_DIR:-src}/.env"
    else
        while [ "${DIR}" != "/" ]; do
            DIR="$(dirname "${DIR}")"
            if [ -f "${DIR}/${APP_DIR:-src}/.env" ]; then
                printf '%s' "${DIR}/${APP_DIR:-src}/.env"
                return 0
            fi
        done
    fi
    return 0
}

update_env_url() {
    local ENVF URL
    ENVF="$(locate_app)"
    URL="$1"
    [ -n "${ENVF}" ] && [ -n "${URL}" ] || return 0
    if grep -qE '^APP_URL=.*' "${ENVF}"; then
        sed -i "s|^APP_URL=.*|APP_URL=\"${URL}\"|" "${ENVF}"
    else
        printf 'APP_URL="%s"\n' "${URL}" >> "${ENVF}"
    fi
    echo "(APP_URL updated to match this link)"
}

# the tunnel is useless if the app behind it is down — make sure the
# dev server answers on :8000, and start it when it does not
ensure_server() {
    if curl -s --max-time 2 -o /dev/null "http://127.0.0.1:${PORT}"; then
        return 0
    fi
    echo "🌐 dev server not running — starting it first…"
    if command -v serve >/dev/null 2>&1; then
        serve
    elif [ -x "$HOME/.local/bin/serve" ]; then
        "$HOME/.local/bin/serve"
    else
        echo "⚠  serve command not found — start the server manually and retry"
        return 1
    fi
    sleep 2
    if curl -s --max-time 3 -o /dev/null "http://127.0.0.1:${PORT}"; then
        return 0
    fi
    echo "⚠  server still not answering on :${PORT} — see /tmp/laravel-serve.log"
    return 1
}

# --- 1. make sure an authtoken is configured ---------------------------
if ! ngrok config check >/dev/null 2>&1; then
    TOKEN="${NGROK_AUTHTOKEN:-}"
    if [ -z "${TOKEN}" ] && [ -f "$HOME/.ngrok-token" ]; then
        TOKEN="$(cat "$HOME/.ngrok-token")"
    fi
    if [ -z "${TOKEN}" ]; then
        echo "NGROK_AUTHTOKEN not configured."
        echo "Add the Codespace secret NGROK_AUTHTOKEN (github.com/settings/codespaces), or run:"
        echo "  ngrok config add-authtoken <token>"
        exit 1
    fi
    ngrok config add-authtoken "${TOKEN}" >/dev/null
fi

# --- 2. dev server must be up before exposing it -----------------------
if ! ensure_server; then
    echo "⚠  continuing anyway — the tunnel will start, but the app may show errors"
fi

# --- 3. tunnel already running? just print its URL ---------------------
URL="$(resolve_url)"
if [ -n "${URL}" ]; then
    update_env_url "${URL}"
    echo "${URL}"
    exit 0
fi

# --- 4. start the tunnel and wait for it -------------------------------
echo "🌐 starting ngrok tunnel on port ${PORT}..."
nohup ngrok http "${PORT}" --log stdout --log-format logfmt >/tmp/ngrok.log 2>&1 &

URL=""
for _ in $(seq 1 20); do
    sleep 1
    URL="$(resolve_url)"
    if [ -n "${URL}" ]; then
        break
    fi
done

if [ -n "${URL}" ]; then
    update_env_url "${URL}"
    echo "${URL}"
    exit 0
fi

echo "⚠  the tunnel did not start within 20s — last ngrok log lines:"
tail -5 /tmp/ngrok.log 2>/dev/null
exit 1
